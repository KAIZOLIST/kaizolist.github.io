rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email != null && 
        request.auth.token.email.lower() == 'tomatosauceman500@gmail.com'
      );
    }
    
    // Helper function to format email to document ID format
    function getUserDocId(email) {
      return email.lower().replace("@", "_").replace(".", "_").replace(".", "_").replace(".", "_").replace(".", "_");
    }

    function isHelper() {
      return request.auth != null && request.auth.token.email != null && (
        isAdmin() ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/users/$(getUserDocId(request.auth.token.email)))
      );
    }

    match /users/{userId} {
      // Allow authenticated user to get their user profile to verify role, or admin to list/write
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /levels/{levelId} {
      allow read: if true;
      allow write: if isAdmin() || isHelper();
    }

    match /image_chunks/{chunkId} {
      allow read: if true;
      allow write: if isAdmin() || isHelper();
    }

    match /bundles/{bundleId} {
      allow read: if true;
      allow write: if isAdmin() || isHelper();
    }

    match /submissions/{submissionId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin() || isHelper();
    }

    match /players/{playerId} {
      allow read: if true;
      allow write: if isAdmin() || isHelper();
    }

    match /deletedLevels/{levelId} {
      allow read: if true;
      allow write: if isAdmin() || isHelper();
    }

    match /deletedPlayers/{playerId} {
      allow read: if true;
      allow write: if isAdmin() || isHelper();
    }

    match /test/{docId} {
      allow read, write: if true;
    }

    // Default deny for unhandled paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
